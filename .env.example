# 국가법령정보 공동활용 Open API OC 값
# https://open.law.go.kr 에서 이메일 가입 후 발급 (이메일이 user@domain.com 이면 OC=user)
LAW_API_OC=test

# Copilot(OpenAI) API 키 — 검색 결과 Q&A용
# https://platform.openai.com/api-keys 에서 발급
COPILOT_API_KEY=
# 또는
# OPENAI_API_KEY=sk-...
# 선택: 모델명 (기본 gpt-4o-mini)
# COPILOT_MODEL=gpt-4o-mini

# Azure OpenAI를 쓰는 경우 (선택)
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
