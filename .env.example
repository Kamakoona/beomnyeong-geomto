# 국가법령정보 공동활용 Open API OC 값
# https://open.law.go.kr 에서 이메일 가입 후 발급 (이메일이 user@domain.com 이면 OC=user)
LAW_API_OC=test

# Claude(Anthropic) API 키 — 검색 결과 Q&A용
# https://console.anthropic.com/settings/keys 에서 발급
COPILOT_API_KEY=
# 또는
# ANTHROPIC_API_KEY=sk-ant-...

# 선택: 모델명 (기본 claude-sonnet-4-5)
# COPILOT_MODEL=claude-sonnet-4-5
# ANTHROPIC_MODEL=claude-sonnet-4-5
